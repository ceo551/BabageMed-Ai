         Edge-to-edge layout — Compose draws under the status & nav bars,
         WindowCompat.setDecorFitsSystemWindows(window,false) in MainActivity. -->
    <style name="Theme.PervagansAI" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0A0A0C</item>
        <item name="android:statusBarColor">#00000000</item>
        <item name="android:navigationBarColor">#00000000</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
