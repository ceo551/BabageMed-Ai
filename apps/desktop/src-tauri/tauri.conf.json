{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pervagans AI",
  "version": "0.1.0",
  "identifier": "com.pervagans.ai.desktop",
  "build": {
    "devUrl":  "http://localhost:3000",
    "frontendDist": "../public",
    "beforeDevCommand":  "npm --prefix ../web run dev",
    "beforeBuildCommand": "npm --prefix ../web run build && cp -R ../web/.next/standalone ../desktop/public"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label":  "main",
        "title":  "Pervagans AI",
        "width":  1280,
        "height": 800,
        "minWidth":  900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "decorations": true,
        "shadow": true,
        "visible": true,
        "focus": true,
        "acceptFirstMouse": true,
        "dragDropEnabled": true,
        "url": "https://babagemed.com",
        "windowEffects": {
          "effects": ["mica"]
        }
      }
    ],
    "security": {
      "csp": "default-src 'self' https://babagemed.com; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://babagemed.com https://cdn.paddle.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://babagemed.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://babagemed.com wss://babagemed.com https://api.anthropic.com https://generativelanguage.googleapis.com https://*.paddle.com; frame-src https://*.paddle.com",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/pervagans/*", "$APPDATA/pervagans/**", "$RESOURCE/*"]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["pervagans"]
      }
    },
    "updater": {
      "active": false,
      "dialog": true,
      "endpoints": [
        "https://babagemed.com/api/desktop/update/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "REPLACE_ME_WITH_TAURI_SIGNER_GENERATE_OUTPUT_BEFORE_ENABLING"
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "copyright": "© 2026 Pervagans AI",
    "shortDescription": "Pervagans AI — desktop client",
    "longDescription": "Pervagans AI desktop wrapper. Loads the Pervagans web app in a native shell for Windows, with hardware-accelerated rendering, system tray, native dialogs, secure credential storage and global shortcuts.",
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["English", "Arabic"]
      }
    }
  }
}
