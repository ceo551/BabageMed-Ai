{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Babbage AI",
  "version": "0.1.0",
  "identifier": "com.babbage.ai.desktop",
  "build": {
    "devUrl":  "http://localhost:3000",
    "frontendDist": "../public",
    "beforeDevCommand":  "npm --prefix ../web run dev",
    "beforeBuildCommand": "npm --prefix ../web run build && cp -R ../web/.next/standalone ../desktop/public"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title":  "Babbage AI",
        "width":  1280,
        "height": 800,
        "minWidth":  900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "decorations": true,
        "url": "https://babagemed.com",
        "_comment_url": "Production builds load the hosted web app at babagemed.com so all 540 connectors + auth state survive across platforms without re-implementing them client-side."
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "copyright": "© 2026 Babbage AI",
    "shortDescription": "Babbage AI — desktop client",
    "longDescription": "Babbage AI desktop wrapper. Loads the Babbage web app in a native shell for Windows, macOS and Linux Ubuntu.",
    "targets": ["msi", "nsis", "dmg", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["English", "Arabic"]
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libayatana-appindicator3-1"]
      }
    }
  }
}
