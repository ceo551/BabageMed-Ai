{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Babbage AI",
  "version": "0.1.0",
  "identifier": "com.babbage.ai.desktop",
  "build": {
    "devUrl":  "http://localhost:3000",
    "frontendDist": "../public",
    "beforeDevCommand":  "npm --prefix ../web run dev",
    "beforeBuildCommand": "npm --prefix ../web run build && cp -R ../web/.next/standalone ../desktop/public"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label":  "main",
        "title":  "Babbage AI",
        "width":  1280,
        "height": 800,
        "minWidth":  900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "transparent": false,
        "decorations": true,
        "shadow": true,
        "visible": true,
        "focus": true,
        "acceptFirstMouse": true,
        "dragDropEnabled": true,
        "url": "https://babagemed.com",
        "windowEffects": {
          "effects": ["mica"]
        }
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/*", "$APPDATA/**", "$RESOURCE/*"]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["babbage"]
      }
    },
    "updater": {
      "active": true,
      "dialog": true,
      "endpoints": [
        "https://babagemed.com/api/desktop/update/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": ""
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "copyright": "© 2026 Babbage AI",
    "shortDescription": "Babbage AI — desktop client",
    "longDescription": "Babbage AI desktop wrapper. Loads the Babbage web app in a native shell for Windows, macOS and Linux Ubuntu, with hardware-accelerated rendering, system tray, native dialogs, secure keychain storage and global shortcuts.",
    "targets": ["msi", "nsis", "dmg", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "exceptionDomain": "babagemed.com",
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["English", "Arabic"]
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libayatana-appindicator3-1"]
      }
    }
  }
}
