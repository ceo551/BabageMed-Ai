{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "MCP tool calls — rate",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum by (mcp_id) (rate(mcp_tool_calls_total[$__rate_interval]))", "legendFormat": "{{mcp_id}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "title": "MCP error rate — top 10",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "topk(10, sum by (mcp_id) (rate(mcp_tool_calls_total{outcome=\"error\"}[$__rate_interval])) / sum by (mcp_id) (rate(mcp_tool_calls_total[$__rate_interval])))",
          "legendFormat": "{{mcp_id}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "title": "MCP tool p95 latency — top 10",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "topk(10, histogram_quantile(0.95, sum by (mcp_id, tool, le) (rate(mcp_tool_duration_seconds_bucket[$__rate_interval]))))",
          "legendFormat": "{{mcp_id}} / {{tool}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "MCP up / down",
      "type": "stat",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "count(up{job=~\".*mcps.*\"} == 1)", "legendFormat": "up" },
        { "expr": "count(up{job=~\".*mcps.*\"} == 0)", "legendFormat": "down" }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "title": "Backend HTTP request rate",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum by (route) (rate(backend_http_requests_total[$__rate_interval]))", "legendFormat": "{{route}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "title": "Backend p95 latency by route",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (route, le) (rate(backend_http_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{route}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "LLM call rate by provider",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 24, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum by (provider, outcome) (rate(backend_llm_calls_total[$__rate_interval]))", "legendFormat": "{{provider}} / {{outcome}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "title": "LLM p95 latency by provider / model",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 24, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (provider, model, le) (rate(backend_llm_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{provider}} / {{model}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "title": "Payments — by provider + status",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 32, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum by (provider, status) (rate(backend_payments_total[5m]))", "legendFormat": "{{provider}} / {{status}}" }
      ]
    },
    {
      "title": "Auth — signups + logins",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 32, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "rate(backend_auth_signups_total[$__rate_interval])", "legendFormat": "signups" },
        { "expr": "sum by (outcome) (rate(backend_auth_logins_total[$__rate_interval]))", "legendFormat": "login / {{outcome}}" }
      ]
    },
    {
      "title": "Per-MCP drilldown — pick an MCP",
      "type": "table",
      "gridPos": { "x": 0, "y": 40, "w": 24, "h": 12 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        { "expr": "sum by (mcp_id, tool, outcome) (rate(mcp_tool_calls_total{mcp_id=~\"$mcp\"}[$__rate_interval]))", "format": "table", "instant": true }
      ]
    },
    {
      "title": "Logs — last 100 lines for $mcp (Loki)",
      "type": "logs",
      "gridPos": { "x": 0, "y": 52, "w": 24, "h": 12 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        {
          "expr": "{namespace=~\".*pervagans.*\", mcp_id=~\"$mcp\"} | json | line_format \"{{.lvl}} {{.msg}} (trace_id={{.trace_id}})\"",
          "refId": "A"
        }
      ],
      "options": { "showTime": true, "wrapLogMessage": true, "dedupStrategy": "none" }
    }
  ],
  "schemaVersion": 39,
  "tags": ["pervagans", "mcp"],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": { "selected": false, "text": "Prometheus", "value": "Prometheus" }
      },
      {
        "name": "DS_LOKI",
        "type": "datasource",
        "query": "loki",
        "current": { "selected": false, "text": "Loki", "value": "Loki" }
      },
      {
        "name": "DS_TEMPO",
        "type": "datasource",
        "query": "tempo",
        "current": { "selected": false, "text": "Tempo", "value": "Tempo" }
      },
      {
        "name": "mcp",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(mcp_tool_calls_total, mcp_id)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "selected": true, "text": "All", "value": "$__all" }
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "Pervagans AI — overview",
  "uid": "pervagans-overview",
  "version": 1,
  "weekStart": ""
}
