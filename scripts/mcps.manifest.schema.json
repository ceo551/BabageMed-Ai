{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://babagemed.com/schemas/mcps.manifest.json",
  "title": "Babbage AI MCP Manifest",
  "description": "Single source of truth for the 540 MCP servers in the fleet. Used by scripts/generate-mcps.mjs to scaffold per-MCP directories, by the Helm chart to render deployments, and by the catalog UI to surface tools.",
  "type": "object",
  "required": ["servers"],
  "properties": {
    "$comment": { "type": "string" },
    "servers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/server" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "server": {
      "type": "object",
      "required": ["id", "name", "kind", "category", "port", "tools", "feature"],
      "properties": {
        "id":       { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "name":     { "type": "string", "minLength": 1, "maxLength": 200 },
        "kind":     { "enum": ["api", "scrape", "hybrid", "stub"] },
        "category": { "type": "string", "minLength": 1, "maxLength": 64 },
        "port":     { "type": "integer", "minimum": 6101, "maximum": 6999 },
        "base":     { "type": "string" },
        "tools":    {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
          "uniqueItems": true
        },
        "feature":  {
          "enum": [
            "healthcare", "education", "writing", "translation",
            "data-analysis", "business", "financial", "consulting",
            "image-video", "advertisements"
          ]
        },
        "homepage": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
