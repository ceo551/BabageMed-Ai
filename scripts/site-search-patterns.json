{
  "$comment": "Per-site search URL templates + result selectors used by the generated scrape MCPs. {q} is replaced with encodeURIComponent(query). When a site is missing here, the generator falls back to /?s={q} which works for WordPress and some others. The 'result' selector identifies each search-result row; 'title', 'link', and 'snippet' are CSS selectors relative to that row (omit any to use sensible defaults).",
  "defaults": {
    "search": "{base}/?s={q}",
    "result": "article, .post, .search-result, li",
    "title": "h1, h2, h3, .title, a",
    "link": "a",
    "snippet": "p, .excerpt, .summary"
  },
  "patterns": {
    "_oup": {
      "search": "{base}/search-results?page=1&q={q}",
      "result": ".al-article-items, .search-result-item",
      "title": ".sri-title a, .item-title a",
      "link": ".sri-title a, .item-title a",
      "snippet": ".sri-snippet, .excerpt"
    },
    "_bmj": {
      "search": "{base}/search/{q}",
      "result": ".highwire-search-result, .search-result",
      "title": "h2 a, .highwire-cite-title a",
      "link": "h2 a, .highwire-cite-title a",
      "snippet": ".highwire-search-result-snippet"
    },
    "_bmc": {
      "search": "{base}/search?query={q}",
      "result": ".c-list-group__item, .c-article-list__item",
      "title": "h3 a, .c-card__title a",
      "link": "h3 a, .c-card__title a",
      "snippet": ".c-list-group__abstract"
    },
    "_plos": {
      "search": "{base}/search?q={q}",
      "result": ".search-result, li.search-results-item",
      "title": ".search-result-title a, h2 a",
      "link": ".search-result-title a, h2 a",
      "snippet": ".search-result-abstract, .abstract"
    },
    "_jmir": {
      "search": "{base}/search?q={q}",
      "result": ".search-result-row, .article-list-item",
      "title": "h2 a, h3 a",
      "link": "h2 a, h3 a",
      "snippet": ".abstract, .summary"
    },
    "_mdpi": {
      "search": "https://www.mdpi.com/search?q={q}",
      "result": ".article-content, .mdpi-search-result",
      "title": ".title-link, h3 a",
      "link": ".title-link, h3 a",
      "snippet": ".abstract-cropped, .abstract-full"
    },
    "_jama": {
      "search": "{base}/searchresults?q={q}",
      "result": ".search-result, .article-item",
      "title": "h3 a, .item-title a",
      "link": "h3 a, .item-title a",
      "snippet": ".snippet"
    },
    "_lancet": {
      "search": "{base}/action/doSearch?AllField={q}",
      "result": ".articleListItem, .search-result-item",
      "title": ".articleTitle a, h3 a",
      "link": ".articleTitle a, h3 a",
      "snippet": ".articleSnippet"
    },
    "_wiley": {
      "search": "{base}/action/doSearch?AllField={q}",
      "result": ".search__item, .articleListItem",
      "title": ".publication_title a, h3 a",
      "link": ".publication_title a, h3 a",
      "snippet": ".search-result-snippet"
    },
    "_elsevier": {
      "search": "{base}/?ssrcomp=full&search={q}",
      "result": ".result-item-content",
      "title": "a.result-list-title-link",
      "link": "a.result-list-title-link",
      "snippet": ".result-item-abstract"
    },
    "_nature": {
      "search": "{base}/search?q={q}",
      "result": ".c-card, article",
      "title": "h3 a, .c-card__title a",
      "link": "h3 a, .c-card__title a",
      "snippet": ".c-card__summary"
    },
    "_aha": {
      "search": "{base}/action/doSearch?AllField={q}",
      "result": ".search__item, .articleListItem",
      "title": ".publication_title a, h3 a",
      "link": ".publication_title a, h3 a",
      "snippet": ".search-result-snippet"
    },
    "_acpjournals": {
      "search": "{base}/action/doSearch?AllField={q}",
