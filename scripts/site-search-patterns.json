      "search": "{base}/search-results?q={q}",
      "result": ".al-article-items, .search-result-item, .article-list-item",
      "title": ".sri-title a, h3 a",
      "link": ".sri-title a, h3 a",
      "snippet": ".sri-snippet"
    },
    "_springer": {
      "search": "{base}/search?query={q}",
