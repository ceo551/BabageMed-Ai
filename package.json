{
  "name": "babbage-ai",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["packages/*", "mcps/*", "apps/web", "apps/desktop"],
  "scripts": {
    "generate:mcps": "node scripts/generate-mcps.mjs && node scripts/write-real-tools.mjs",
    "build:base": "cd packages/mcp-base && npm run build",
    "compose:up": "docker compose -f docker-compose.yml -f docker-compose.mcps.yml up -d --build",
    "compose:down": "docker compose -f docker-compose.yml -f docker-compose.mcps.yml down",
    "compose:logs": "docker compose -f docker-compose.yml -f docker-compose.mcps.yml logs -f"
  }
}
