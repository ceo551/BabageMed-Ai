# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:3000
BACKEND_URL=http://backend:8080

# ─── LLM reasoning engines (used by Go backend orchestrator) ─────────────────
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# ─── PubMed / NCBI E-utilities (optional but raises rate limit to 10/s) ──────
NCBI_API_KEY=
NCBI_TOOL=BabageMedAI
NCBI_EMAIL=ceo@babagemed.com

# ─── WHO ICD API (https://icd.who.int/icdapi) ────────────────────────────────
WHO_ICD_CLIENT_ID=
WHO_ICD_CLIENT_SECRET=

# ─── CDC Socrata Open Data ───────────────────────────────────────────────────
SOCRATA_APP_TOKEN=

# ─── openFDA / DailyMed share base, no key required but recommended ─────────
OPENFDA_API_KEY=

# ─── NPI Registry (NPPES) — no key ───────────────────────────────────────────

# ─── ChEMBL / PubChem — no key ───────────────────────────────────────────────

# ─── ClinicalTrials.gov v2 — no key ──────────────────────────────────────────

# ─── NCI / NIH thesaurus — no key, EVS public ────────────────────────────────

# ─── NHS England API ─────────────────────────────────────────────────────────
NHS_API_KEY=

# ─── Crossref (used for journal MCPs that have no direct API) ────────────────
CROSSREF_MAILTO=ceo@babagemed.com

# ─── Hugging Face ────────────────────────────────────────────────────────────
HF_API_TOKEN=

# ─── Kaggle ──────────────────────────────────────────────────────────────────
KAGGLE_USERNAME=
KAGGLE_KEY=

# ─── Notion ──────────────────────────────────────────────────────────────────
NOTION_TOKEN=

# ─── Slack ───────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=

# ─── GitHub (already configured server-side via MCP integration) ─────────────
GITHUB_TOKEN=

# ─── Google APIs (OAuth client) ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ─── Microsoft 365 ───────────────────────────────────────────────────────────
MS365_CLIENT_ID=
MS365_CLIENT_SECRET=
MS365_TENANT_ID=
MS365_REFRESH_TOKEN=

# ─── LinkedIn (limited public API) ───────────────────────────────────────────
LINKEDIN_ACCESS_TOKEN=

# ─── Gamma.app (no public API; uses session cookie scraping) ─────────────────
GAMMA_SESSION_COOKIE=

# ─── Hostinger / GoDaddy ─────────────────────────────────────────────────────
HOSTINGER_API_TOKEN=
GODADDY_API_KEY=
GODADDY_API_SECRET=

# ─── Payments — Paymob (Egypt) ───────────────────────────────────────────────
# Get these from the Paymob dashboard: Settings → Account info & Payment Integrations
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC=

# ─── Payments — PayPal ───────────────────────────────────────────────────────
# Create an app at https://developer.paypal.com/dashboard. Use "sandbox" until launch.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# ─── Scraper config (shared by all scrape-driven MCPs) ───────────────────────
SCRAPER_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36
SCRAPER_RATE_RPS=1
SCRAPER_TIMEOUT_MS=30000
SCRAPER_HEADLESS=true
SCRAPER_CACHE_TTL_SEC=86400
# Optional residential/HTTP proxy. Use only with sources whose ToS allows it.
SCRAPER_PROXY_URL=
