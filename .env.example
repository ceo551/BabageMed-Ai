# ─── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info
PUBLIC_BASE_URL=http://localhost:3000
BACKEND_URL=http://backend:8080
# Comma-separated CORS allow-list for the backend. PUBLIC_BASE_URL plus
# the Windows Tauri origin (http://tauri.localhost) are added by default.
CORS_ALLOWED_ORIGINS=

# Backend port (defaults to 8080 if unset).
PORT=8080

# Override the MCP DNS suffix the backend uses to reach connectors. Empty
# uses the in-cluster Service names produced by the Helm chart.
MCP_HOST_OVERRIDE=

# Optional Redis (in-cluster cache). When unset the backend's cache
# package no-ops. Set to redis://:PASSWORD@host:6379/0 for prod.
REDIS_URL=

# ─── Google Vertex AI (when using Anthropic-on-Vertex / Gemini) ──────────────
# When GOOGLE_CLOUD_PROJECT is set the LLM client uses Vertex via Workload
# Identity Federation; GOOGLE_API_KEY is ignored. Empty → AI Studio path.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# Anthropic models on Vertex live in a different region set than Gemini.
VERTEX_ANTHROPIC_LOCATION=us-east5
# Path to the WIF external-account.json (mounted by the chart). Read by
# the Google ADC library.
GOOGLE_APPLICATION_CREDENTIALS=

# ─── OpenTelemetry ──────────────────────────────────────────────────────────
OTEL_TRACING_ENABLED=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_SERVICE_NAME=babagemed-backend
OTEL_RESOURCE_ATTRIBUTES=

# ─── Postgres (auth + persistence) ───────────────────────────────────────────
# Default values match docker-compose.yml; change for production.
POSTGRES_USER=babagemed
POSTGRES_PASSWORD=babagemed
POSTGRES_DB=babagemed
# Override DATABASE_URL only if pointing at an external DB.
# DATABASE_URL=postgres://babagemed:babagemed@postgres:5432/babagemed?sslmode=disable

# Email of the user to auto-promote to admin on every backend startup.
# Safe to leave empty; the user must sign up at /signup first.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# ─── LLM reasoning engines (used by Go backend orchestrator) ─────────────────
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# ─── PubMed / NCBI E-utilities (optional but raises rate limit to 10/s) ──────
NCBI_API_KEY=
NCBI_TOOL=BabageMedAI
NCBI_EMAIL=admin@example.com

# ─── WHO ICD API (https://icd.who.int/icdapi) ────────────────────────────────
WHO_ICD_CLIENT_ID=
WHO_ICD_CLIENT_SECRET=

# ─── CDC Socrata Open Data ───────────────────────────────────────────────────
SOCRATA_APP_TOKEN=

# ─── openFDA / DailyMed share base, no key required but recommended ─────────
OPENFDA_API_KEY=

# ─── NPI Registry (NPPES) — no key ───────────────────────────────────────────

# ─── ChEMBL / PubChem — no key ───────────────────────────────────────────────

# ─── ClinicalTrials.gov v2 — no key ──────────────────────────────────────────

# ─── NCI / NIH thesaurus — no key, EVS public ────────────────────────────────

# ─── NHS England API ─────────────────────────────────────────────────────────
NHS_API_KEY=

# ─── Crossref (used for journal MCPs that have no direct API) ────────────────
CROSSREF_MAILTO=admin@example.com

# ─── Hugging Face ────────────────────────────────────────────────────────────
HF_API_TOKEN=

# ─── Kaggle ──────────────────────────────────────────────────────────────────
KAGGLE_USERNAME=
KAGGLE_KEY=

# ─── Notion ──────────────────────────────────────────────────────────────────
NOTION_TOKEN=

# ─── Slack ───────────────────────────────────────────────────────────────────
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=

# ─── GitHub (already configured server-side via MCP integration) ─────────────
GITHUB_TOKEN=

# ─── Google APIs (OAuth client) ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ─── Microsoft 365 ───────────────────────────────────────────────────────────
MS365_CLIENT_ID=
MS365_CLIENT_SECRET=
MS365_TENANT_ID=
MS365_REFRESH_TOKEN=

# ─── LinkedIn (limited public API) ───────────────────────────────────────────
LINKEDIN_ACCESS_TOKEN=

# ─── Gamma.app (no public API; uses session cookie scraping) ─────────────────
GAMMA_SESSION_COOKIE=

# ─── Hostinger / GoDaddy ─────────────────────────────────────────────────────
HOSTINGER_API_TOKEN=
GODADDY_API_KEY=
GODADDY_API_SECRET=

# ─── Payments — Paymob (Egypt) ───────────────────────────────────────────────
# Get these from the Paymob dashboard: Settings → Account info & Payment Integrations
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC=

# ─── Payments — PayPal ───────────────────────────────────────────────────────
# Create an app at https://developer.paypal.com/dashboard. Use "sandbox" until launch.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# ─── Scraper config (shared by all scrape-driven MCPs) ───────────────────────
SCRAPER_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36
SCRAPER_RATE_RPS=1
SCRAPER_TIMEOUT_MS=30000
SCRAPER_HEADLESS=true
SCRAPER_CACHE_TTL_SEC=86400
# Optional residential/HTTP proxy. Use only with sources whose ToS allows it.
SCRAPER_PROXY_URL=

# ─── Desktop auto-updater ────────────────────────────────────────────────────
# Source of the per-release manifest. Set ONE of the three below:
#   DESKTOP_UPDATES_MANIFEST       — inline JSON (handy for tests / staging)
#   DESKTOP_UPDATES_MANIFEST_URL   — remote JSON, e.g. a GitHub release asset
#   DESKTOP_UPDATES_MANIFEST_PATH  — local file path (mounted ConfigMap)
# Leave them all empty and the endpoint answers 204 to every poll, which
# Tauri reads as "no update available" — safe default for fresh deploys.
#
# Manifest shape:
#   { "version": "0.2.0",
#     "pub_date": "2026-05-25T00:00:00Z",
#     "notes": "Bug fixes",
#     "platforms": {
#       "windows-x86_64":  { "url": "...", "signature": "..." }
#     }
#   }
# The desktop client ships for Windows only.
#
# The signature value is the contents of the .sig file Tauri emits next
# to each installer when TAURI_SIGNING_PRIVATE_KEY is set during build.
DESKTOP_UPDATES_DISABLED=
DESKTOP_UPDATES_MANIFEST=
DESKTOP_UPDATES_MANIFEST_URL=
DESKTOP_UPDATES_MANIFEST_PATH=

# ── Email (transactional) ─────────────────────────────────────────────
# Used by password-reset + email-verification flows. When SMTP_HOST or
# SMTP_FROM is missing, the email package falls back to a console
# driver that logs the message body — fine for dev, NEVER acceptable
# in prod (reset links would only appear in container logs).
SMTP_HOST=smtp.example.com:587
SMTP_FROM=noreply@example.com
SMTP_USER=
SMTP_PASS=

# Public base URL — used to build reset / verification links the user
# clicks in their inbox. Must NOT have a trailing slash.
PUBLIC_BASE_URL=https://app.example.com

# ── MFA / TOTP ────────────────────────────────────────────────────────
# AES-GCM key (32 bytes, base64-encoded) for encrypting TOTP secrets
# at rest. Generate via:
#   head -c 32 /dev/urandom | base64
# When unset, the MFA endpoints return 503 ("mfa not configured")
# rather than silently storing secrets in plaintext. Rotating the key
# breaks every existing enrollment — store it in a real secret manager.
MFA_ENCRYPTION_KEY=
